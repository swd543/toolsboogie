# --- Public site configuration (build time) --------------------------
# Full public URL of the deployed site. Used for sitemap.xml, robots.txt
# and absolute links (Open Graph). No trailing slash.
VITE_SITE_URL=https://yourname.github.io

# Base path when hosting on a GitHub *project* page, i.e.
# https://user.github.io/<repo>/. Trailing slash required, e.g. /toolsboogie/
# Leave empty (or "/") for a user site (https://user.github.io).
VITE_BASE=/

# Pages deploy builds with VITE_BASE=/ — the custom domain tools.bugaboxes.com
# is bound to the site root by GitHub (see .github/workflows/ci.yml).

# --- Google AdSense (optional) ---------------------------------------
# AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty to run
# ad-free; the ad slots render nothing. See docs/ADS.md for the plan.
VITE_ADSENSE_CLIENT=
